# Copy to .env.local (git-ignored) and fill in.
# Anything prefixed VITE_ is embedded in the public bundle — never put a
# real secret here. Web3Forms access keys are designed to be public and are
# scoped to a single destination inbox.

# Where contact-form submissions are POSTed. Must be HTTPS and on the
# allowlist in src/lib/contactForm.ts.
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit

# Public access key from https://web3forms.com (delivers to info@katalayyasevents.com)
VITE_FORM_ACCESS_KEY=
